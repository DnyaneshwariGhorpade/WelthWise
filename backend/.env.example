# Supabase (PostgreSQL) — shared transaction-mode pooler (IPv4-only) for app runtime
DATABASE_URL="postgresql://<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase (PostgreSQL) — shared session-mode pooler, used for migrations / schema changes
DIRECT_URL="postgresql://<project-ref>.pooler.supabase.com:5432/postgres"

PORT=3000
NODE_ENV=development

# JWT (HS256) — stateless auth; replaced on logout via Redis blacklist (NFR-07, NFR-11)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
SESSION_IDLE_TIMEOUT_MIN=15

# Password hashing (NFR-07)
BCRYPT_SALT_ROUNDS=10

# Swappable AI provider: openai | gemini (OR-04)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Redis — session / score cache + revoked-JWT blacklist
REDIS_URL=redis://localhost:6379

# Email (forgot-password / reset links — FR-26). Choose one provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WealthWise <no-reply@wealthwise.app>"

# Frontend URL (used in reset links)
APP_URL=http://localhost:5173

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173